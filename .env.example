# Variable-name template only. On Scott's machine, real credentials belong in
# ~/.config/api-keys/.env.master and must never be copied into tracked files.

# Optional paid LLM providers
OPENAI_API_KEY=replace_in_private_store
ANTHROPIC_API_KEY=replace_in_private_store
GEMINI_API_KEY=replace_in_private_store
GOOGLE_API_KEY=replace_in_private_store
DEEPSEEK_API_KEY=replace_in_private_store
DASHSCOPE_API_KEY=replace_in_private_store

# Moonshot AI / Kimi K3
MOONSHOT_API_KEY=replace_in_private_store
KIMI_MODEL=kimi-k3
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Optional media services
DEEPGRAM_API_KEY=replace_in_private_store
ELEVEN_LABS_API_KEY=replace_in_private_store

# Core processing configuration
LOG_LEVEL=INFO
MAX_RETRIES=3
CONCURRENT_TASKS=4
PDF_PROCESSOR_STRATEGY=exclusive
DEFAULT_PDF_PROCESSOR=enhanced_docling
